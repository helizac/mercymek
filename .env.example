MODEL_API_KEY=            # Meta Model API key (from the dashboard)
HF_TOKEN=                 # Hugging Face read token (Nexar dataset is gated)
META_BASE_URL=https://api.meta.ai/v1
ASR_MODEL=muse-voice-transcribe-1.0
VISION_MODEL=muse-spark-1.3
REASONING_MODEL=muse-wonder-1.0   # use muse-spark-1.3 if you have no access
IMAGE_MODEL=muse-image-1.0
SAM_MODEL=sam-3.1
LAYA_DEVICE=cpu
LAYA_MIN_CONFIDENCE=0.95   # tuned with scripts/laya_eval.py (95 % precision on accepted commands)
VISER_PORT=8080
APP_PORT=8000
CASES_DIR=./data/cases
MIC_SOURCE=browser        # browser = HUD captures mic and relays PCM to the server; server = sounddevice on this machine
ELEVENLABS_API_KEY=       # text-to-speech (only the TTS permission is needed)
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVEN_MODEL=eleven_v4_turbo     # ~150 ms to first audio; eleven_flash_v2_5 is ~120 ms
TTS_CHAR_BUDGET=25000     # stop speaking (text only) after this many characters
MAPILLARY_TOKEN=          # optional: Mapillary client token for street-level imagery (free); Panoramax is used otherwise
KAGGLE_API_TOKEN=         # local credential only; never put it in a notebook, source or uploaded dataset
